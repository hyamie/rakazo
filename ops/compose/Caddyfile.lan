# LAN Caddyfile for the VLAN 60 deployment.
#
# The upstream Caddyfile.prod takes a bare hostname and defaults it to
# app.example.com, which makes Caddy attempt a public ACME issuance. There is no
# public DNS record for this box and no inbound path to it, so that fails and
# takes the whole edge down with it.
#
# `local_certs` switches issuance to Caddy's own internal CA. That matters more
# than it looks: Better Auth sets session cookies, and serving plain HTTP would
# put them on the wire in clear across the LAN. The first visit shows a
# certificate warning; trust Caddy's root once (it is at
# /data/caddy/pki/authorities/local/root.crt inside the caddy container) and it
# goes away.

{
	local_certs

	# No HTTP/3. Caddy advertises `alt-svc: h3=":443"`, so after the first load a
	# browser switches to QUIC, and a manually accepted certificate exception does
	# not carry over to it. The page keeps working while individual fetches fail
	# with a bare "Failed to fetch" and nothing reaches the server log, which is
	# indistinguishable from a network fault. Drop this once Caddy's root CA is
	# actually trusted on the client, at which point h3 is fine.
	servers {
		protocols h1 h2
	}

	# Browsers and curl send no SNI when the address bar holds a bare IP (RFC 6066
	# forbids an IP literal in server_name). With no SNI and no default, Caddy has
	# no site to match and the TLS handshake simply hangs: port 443 accepts the
	# connection and nothing ever comes back, which reads as a network block
	# rather than a config problem. This pins the fallback to the IP site, whose
	# certificate carries the matching IP SAN.
	default_sni 192.168.60.10
}

https://192.168.60.10, https://rakazo.sandbox.lan {
	encode zstd gzip

	handle /health {
		reverse_proxy api:3100
	}

	handle /api/* {
		reverse_proxy api:3100
	}

	handle /rpc/* {
		reverse_proxy api:3100
	}

	handle {
		reverse_proxy web:5173
	}
}
