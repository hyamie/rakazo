# Dummy values so `docker compose config` can render both files in CI.
#
# This file exists to make a NEW required variable fail the pull request instead
# of the deploy. Every `${VAR:?...}` in either compose file must have an entry
# here; when upstream adds one, `config` fails with the variable's own message
# and the fix is one line in this file plus a real value in the deployment .env.
#
# Nothing here is a secret and nothing here is ever deployed. `hds-deploy-check`
# copies this to .env because both compose files use `env_file: ../../.env`,
# which --env-file does not satisfy.
POSTGRES_PASSWORD=ci-not-a-real-password
SANDBOX_SUPERVISOR_TOKEN=ci-not-a-real-supervisor-token
